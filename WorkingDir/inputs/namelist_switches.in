!-------------------------------------------------------------------------------
!                        --- USER SWITCHES FOR ICPM ---                        !
!-------------------------------------------------------------------------------
! Switches
&switchdata
initflag        = 1,      !< 1/2/3/4/5 : Sets which aerosol input is desired (2-5 are pre-defined aerosol cases)
                        !!               1 = Will use parameters set in namelist_UserVars.in
                        !!               2 = Pre-defined marine average parameters from DP2012, DP2011 (all other switches in this namelist will be overrided)
                        !!               3 = Pre-defined marine arctic parameters from DP2012, DP2011 (all other switches in this namelist will be overrided)
                        !!               4 = Pre-defined clean continental parameters from DP2012, DP2011 (all other switches in this namelist will be overrided)
                        !!               5 = Pre-defined polluted parameters from DP2012, DP2011 (all other switches in this namelist will be overrided)
                        !!               See documentation for full defails of the pre-defined cases and full references.
kprecip         = 0,       !< 0/1/2/... : Number of sub time-steps for precipitation formation through coalescence.
vcycles         = 0,       !< 0/1/2/... : Specify number of vertical up/down cycles through cloud.
envprofile      = 1,    !< 1/2/3 : Used to switch between environmental temperature profiles.
                        !!               1 = User-defined profile
                        !!               2 = Pre-defined summer profile
                        !!               3 = Pre-defined winter profile
                        !!               For full defails on these temperature profiles, see documentation.
                        !!               NOTE: only has an effect when iupadiabat=FALSE.
initwav         = 1,       !< 1/2/3 : Which wavelength file to use for calculation of optical properties.
                        !!               1 = user specified
                        !!               2 = Pre-defined, using king air campaign instrumentation
                        !!               3 = Pre-defined, using ukesm1 campaign instrumentation
                        !!               4 = Pre-defined, using activate campaign instrumentation
                        !!               For full defails on these wavelengths, see documentation.
initrebin       = 1,     !< 1/2/3 : Specify which limits to use in the rebinning of the droplet spectra.
                        !!               1 = User specified
                        !!               2 = Pre-defined, using maseii campaign instrumentation
                        !!               3 = Pre-defined, using activate campaign instrumentation
                        !!               For full defails on these rebin limits, see documentation.
initaer         = 1,        !< 1/2 : Sets which aerosol initialisation to use.
                        !!               1 = default
                        !!               2 = m7par.
customaer = 0,              !< 0/1/2 : Sets which aerosol inputs are input from .dat files
                        !!               0 = None
                        !!               1 = size-distribution (including bins)
                        !!               2 = size distribution and composition 
ccn_output_type = 1,!< 1/2 : `ccn_conc_spectrum` will be converted from [number/g of air]->[Number/cm3] using either:
                        !!               1 = rho (as calculated within the model);
                        !!               2 = p/(RT) (following the ideal gas law).
iupconst        = 1,       !< 1/2/3 : Defines the updraft/downdraft behaviour.
                        !!               1 = Constant updraft/downdraft velocity defined by user-input
                        !!               2 = Buoyancy explicitly calculated by the model, and used to set the vertical velocity
                        !!               3 = updraft/downdraft behaviour based on height trajectory given by user
istoptop        = F,       !< T/F : T = When parcel reaches neutral buoyancy and begins to fall, stop the vertical ascent/descent.
                        !!               NOTE: may only be used with iupconst=FALSE.
irainfall       = F,      !< T/F : T = Perform gravitational settling of precipitation sized drops
iupadiabat      = T,     !< T/F : Specify ascent/descent dynamics type.
                        !!               T = Adiabatic
                        !!               F = Pseudo-adiabatic
iaerenv         = F,        !< T/F : Entraining switch.
                        !!               T = Entraining with aerosols (not currenly operational, do not use).
                        !!               F = Entraining without aerosols
istopheight     = F,    !< T/F : T = Parcel will stop vertical ascent at specified height through cloud, see `zstopheight` to set depth from cloud base.
                        !!               With this TRUE, be careful to set `time_limit` to a sensible value.
vclowheight     = T,       !< T/F : Defines lower limit for vcycles.
                        !!              T = cloud base
                        !!              F = initial heigth
iendssmax       = F,      !< T/F : T = End simulation at maximum supersaturation
ihoutputs       = F,      !< T/F : T = Use inputs/fixed_level_alt_out.dat to output at specific height levels
interp          = T,         !< T/F : T = Perform interpolation after main loop directly onto pheightstep levels
output_logs     = T,    !< T/F : T = Re-direct the standard I/O output is to `logs/logs.txt` and logs/logs_errors.txt`
icompfilm       = F,      !< T/F : T=ON F=OFF : Approximate compressed film model (Lowe et al. NatComms)
icondsvocs      = T,     !< T/F : T=ON F=OFF : Implementation of SVOC condensation equations
out_aerdat      = F,     !< T/F : T=ON F=OFF : output .dat files of custom aerosol, analogous to custom aerosol input
icwc            = F,     !< T/F : T=ON F=OFF : aqueous phase chemistry calculations(Sulfate production)
&END
!
!-------------------------------------------------------------------------------
!END OF FILE
